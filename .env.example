# Copy to .env and fill in. Used by `docker compose` and by `npm run dev`.
# Every variable is documented in docs/configuration.md.

# Steam Web API key (docs/api-keys.md). Needed to import your Steam library.
STEAM_API_KEY=
# Language of achievement names and descriptions
STEAM_LANGUAGE=english

# Optional: IGDB, to search for games on every platform (docs/api-keys.md)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Port on the host
PORT=8788

# Main URL you open Savepoint from, and any others (comma separated)
APP_URL=
ALLOWED_ORIGINS=

# Where the database and backups live on the host
DATA_DIR=/DATA/AppData/savepoint

STORE_COUNTRY=US
TZ=Europe/Paris
PUID=1000
PGID=1000
BACKUP_RETENTION_DAYS=14

# Optional: create the first admin account on first start (otherwise the app shows a setup page)
ADMIN_USERNAME=
ADMIN_PASSWORD=
